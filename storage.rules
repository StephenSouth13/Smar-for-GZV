rules_version = '2';

// Uploads and deletes go through the Next.js server using the Firebase Admin SDK
// (see src/lib/data/media.ts), which bypasses these rules. Uploaded files are
// marked public at upload time and served via their public storage.googleapis.com
// URL, so no client-side Storage access is needed either. Deny all direct access.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
