rules_version = '2';

// All Firestore reads/writes in this app go through the Next.js server using the
// Firebase Admin SDK (Server Components, Server Actions, Route Handlers), which
// bypasses these rules entirely. The client Firebase SDK is only ever used for
// Firebase Auth sign-in on /admin/login, never for direct Firestore access.
// These rules therefore deny all direct client access as a safety net.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
